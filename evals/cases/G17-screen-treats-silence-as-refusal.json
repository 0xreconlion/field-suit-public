    "vertical": "nonprofit",
    "health_or_medical": false,
    "minors": null,
    "eligibility_determinations": false,
    "immigration_status": null,
    "housing_or_dv_services": null,
    "criminal_justice": false,
    "employment_records": false,
    "financial_accounts": false,
    "aggregates_only": true,
    "sponsor_named": true,
    "stop_authority_named": true,
    "governing_authority_adopted_policy": true,
    "data_agreement_signed": true,
    "third_party_terms_reviewed": true,
    "preconditions": [
      "workflow_card",
      "source_register",
      "metric_dictionary",
      "frozen_baseline",
      "human_only_list",
      "named_operator",
      "halt_conditions"
    ]
  },
  "expect": {
